#!/usr/bin/env rexx
/*----------------------------------------------------------------------------*/
/* Booleans.testGroup: Python's bool and ooRexx's .LogicalWrapper.           */
/*                                                                            */
/* Licensed under the Apache License, Version 2.0.                            */
/*----------------------------------------------------------------------------*/
  parse source . . fileSpec

  group = .TestGroup~new(fileSpec)
  group~add(.Booleans.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires 'PyTestCase.cls'
::requires 'logicalwrapper.cls'   -- ooRexx's (r13278 and later)
::requires 'json.cls'
::requires 'yaml.cls'

::class "Booleans.testGroup" subclass PyTestCase public

-- Python -> Rexx: True and False are the two .LogicalWrapper instances
::method test_from_python
  t = .py~eval("1 < 2")
  f = .py~eval("1 > 2")
  self~assertTrue(t~isA(.LogicalWrapper), "True is a .LogicalWrapper")
  self~assertTrue(f~isA(.LogicalWrapper), "False is a .LogicalWrapper")
  self~assertSame(.LogicalWrapper~true~identityHash, t~identityHash, "True is .LogicalWrapper~true")
  self~assertSame(.LogicalWrapper~false~identityHash, f~identityHash, "False is .LogicalWrapper~false")
  -- and they are 1 and 0 for Rexx
  self~assertSame("1", t~string, "string")
  self~assertTrue(t = 1 & f = 0 & t == "1", "comparisons")
  self~assertSame(2, t + 1, "arithmetic")
  self~assertSame(0, \t, "not")
  self~assertTrue(datatype(f, "O"), "a logical value")
  -- a bool inside a container, and JSON's
  self~assertTrue(.py~eval("[True]")[0]~isA(.LogicalWrapper), "an item")
  self~assertTrue(.py~import("json")~loads("true")~isA(.LogicalWrapper), "json.loads")

-- Rexx -> Python: a .LogicalWrapper is a bool; .true and .false stay the numbers 1 and 0
::method test_to_python
  self~assertSame("True",  .py~repr(.LogicalWrapper~true), ".LogicalWrapper~true")
  self~assertSame("False", .py~repr(.LogicalWrapper~false), ".LogicalWrapper~false")
  self~assertSame("bool",  .py~type(.LogicalWrapper~of(0))~getattr("__name__"), "the type")
  self~assertSame("1",     .py~repr(.true), ".true is 1")
  self~assertSame("[True, 0, False]", .py~repr(.array~of(.LogicalWrapper~true, 0, .LogicalWrapper~false)), "in an Array")
  self~assertSame('{"a": true}', .py~import("json")~dumps(.py~dict(.py~kw("a", .LogicalWrapper~true))), "json.dumps")
  -- a module imported as "string" takes Rexx strings as str, but a .LogicalWrapper is a bool
  s = .py~import("builtins", "string")
  self~assertSame("str",  s~type(1)~getattr("__name__"), "string module: 1")
  self~assertSame("bool", s~type(.LogicalWrapper~true)~getattr("__name__"), "string module: .LogicalWrapper")

-- the subclasses, JSON's and YAML's booleans, are bools too; Python's True
-- comes back as .LogicalWrapper~true, not as JSON's
::method test_subclasses
  self~assertSame("True",  .py~repr(.json~true), ".json~true")
  self~assertSame("False", .py~repr(.json~false), ".json~false")
  self~assertSame("[True, False, 1]", .py~repr(.json~new~fromJSON("[true, false, 1]")), "JSON parsed")
  y = .yaml~new~parseString("a: true" || "0a"x || "b: false")
  self~assertSame("bool", .py~type(y["a"])~getattr("__name__"), "YAML's true")
  self~assertSame("True False", .py~repr(y["a"]) .py~repr(y["b"]), "YAML's true and false")
  self~assertSame(.LogicalWrapper~true~identityHash, .py~eval("lambda x: x")~new(.json~true)~identityHash, "back as .LogicalWrapper~true")

-- a bool that goes to Rexx and back is a bool
::method test_round_trip
  b = .py
  b~exec(self~py("def same(x): return x", "def kind(f): return type(f()).__name__"))
  self~assertSame("bool", b~main~kind(.Routine~new("r", "return .LogicalWrapper~true")), "a Rexx routine's result")
  self~assertSame("bool", b~main~kind(.Routine~new("r", "return .py~eval('True')")), "Python's True, through Rexx")
  self~assertSame(.LogicalWrapper~true~identityHash, b~main~same(.LogicalWrapper~true)~identityHash, "Rexx")
  self~assertSame("bool", b~type(b~main~same(b~eval("False")))~getattr("__name__"), "through Rexx")

