#!/usr/bin/env rexx
/*----------------------------------------------------------------------------*/
/* Callbacks.testGroup: Rexx objects in Python (oorexx.RexxObject), called    */
/* back; identity on the way back; errors both ways; nesting.                 */
/*                                                                            */
/* Licensed under the Apache License, Version 2.0.                            */
/*----------------------------------------------------------------------------*/
  parse source . . fileSpec

  group = .TestGroup~new(fileSpec)
  group~add(.Callbacks.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires 'PyTestCase.cls'

::class "Callbacks.testGroup" subclass PyTestCase public

-- a routine of this file, as an object
::method routine private
  use strict arg name
  return .context~package~findRoutine(name)

::method test_routines_as_functions
  b = .py
  words = .array~of("pear", "fig", "banana", "kiwi")
  self~assertSame("['fig', 'pear', 'kiwi', 'banana']", -
                  b~sorted(words, b~kw("key", self~routine("byLength")))~string, "sorted key=routine")
  self~assertSame("[2, 4, 6]", -
                  b~eval("list")~new(b~map(self~routine("double"), .array~of(1, 2, 3)))~string, "list(map(...))")

::method test_rexx_object_in_python
  b = .py
  d = .directory~new
  d~color = "red"
  self~assertTrue(b~eval("lambda x: x")~new(d) == d, "round trip identity")
  self~assertSame("RexxObject", b~type(d)~__name__, "type")
  b~exec(self~py("def get(o, k): return o[k]",       -
                 "def put(o, k, v): o[k] = v",       -
                 "def send(o): return o.items()",    -
                 "def text(o): return str(o)",       -
                 "def each(o): return [x for x in o]"))
  m = b~main
  self~assertSame("red", m~get(d, "COLOR"), "Python o[k]")
  m~put(d, "SIZE", 3)
  self~assertSame("3", d~size, "Python o[k] = v")
  self~assertSame("2", m~send(d), "Python o.items()")
  self~assertSame("a Directory", m~text(d), "Python str(o)")
  self~assertSame("['a', 'b']", m~each(.array~of("a", "b"))~string, "Python iterates")
  self~assertSame("2", b~len(d), "len()")

::method test_arguments_and_results
  b = .py
  self~assertSame("42", b~eval("lambda f: f(20, 22)")~new(self~routine("add")), "callback args")
  self~assertSame("Directory", b~eval("lambda f: f()")~new(self~routine("makeDir"))~class~id, "callback returns obj")

-- errors in Rexx code reach Python as RexxError, and Rexx again as themselves
::method test_rexx_error_round_trip
  co = self~syntaxOf(.py~eval("lambda f: f()"), "new", self~routine("fails"))
  self~assertSame("93.924", co~code, "the Rexx error itself, not 98.900")
  self~assertTrue(pos("Invalid position", co~message) > 0, "its message")

-- a SYNTAX with a description comes back with it, through a Python function
-- and through an ADDRESS environment written in Python.  ooRexx's API cannot
-- raise a SYNTAX with a description (not filed; r13297): raiseAgain puts it
-- into the pending condition object, a workaround this test watches
::method test_rexx_error_description
  co = self~syntaxOf(.py~eval("lambda f: f()"), "new", self~routine("described"))
  self~assertSame("40.1", co~code, "its code")
  self~assertSame("BOOM", co~additional[1], "its ADDITIONAL")
  self~assertSame("the description", co~description, "its description")
  h = .py~eval("lambda f: (lambda c, ctx: f())")~new(self~routine("described"))
  .CommandHandler~register("pydesc", .py~commandHandler(h))
  signal on syntax
  address pydesc "x"
  self~fail("SYNTAX 40.1 must come back through ADDRESS")
syntax:
  .CommandHandler~deregister("pydesc")
  co = condition("O")
  self~assertSame("40.1", co~code, "its code, through ADDRESS")
  self~assertSame("the description", co~description, "its description, through ADDRESS")

::method test_python_catches_rexx_error
  b = .py
  b~exec(self~py("def catch(f):",                       -
                 "    import oorexx",                   -
                 "    try: f()",                        -
                 "    except Exception as e: return type(e).__name__"))
  self~assertSame("RexxError", b~main~catch(self~routine("fails")), "Python catches it")

-- a HALT in Rexx code called by Python is a HALT again back in Rexx (ooRexx
-- gives Python SYNTAX 4.1, with the description gone); untrapped, 4.1 as in
-- plain Rexx
::method test_halt_round_trip
  call = .py~eval("lambda f: f()")
  halts = self~routine("halts")
  self~assertSame("HALT", self~signalOnHalt(call, halts), "SIGNAL ON HALT")
  self~assertSame("HALT .nil", self~callOnHalt(call, halts), "CALL ON HALT: the clause resumes, the call gives .nil")
  self~assertSame("4.1", self~syntaxOf(call, "new", halts)~code, "SYNTAX 4.1 when only SYNTAX is trapped")
  self~assertSame("HALT", self~signalOnHalt(call, self~routine("haltsViaPython")), -
                  "Rexx -> Python -> Rexx -> Python -> Rexx")

::method signalOnHalt private
  use arg pyCallable, f
  signal on halt
  pyCallable~new(f)
  return "no condition"
halt:
  return condition("C")

::method callOnHalt private
  use arg pyCallable, f
  call on halt name halted
  trapped = "no condition"
  x = pyCallable~new(f)
  nop    -- as with a Ctrl-C, CALL ON's handler runs after the next clause
  return trapped (x == .nil)~?(".nil", x)
halted:
  trapped = condition("C")
  return

-- a condition other than SYNTAX raised by a Rexx method that Python sends a
-- message to, with a SIGNAL ON for it in the Rexx code below Python (and in
-- .PyCommandHandler's command): every call from Python attaches its own
-- activity, so the condition stops there and no SIGNAL unwinds through
-- Python's frames (that would end the process)
::method test_signal_not_through_python
  send = .py~eval("lambda o: o.raiser()")
  do c over "USER", "NOTREADY", "ERROR", "FAILURE"
    self~assertSame("no condition", self~signalOnAny(send, .Raiser~new(c)), c "from a method Python calls")
  end
  h = .py~eval("lambda o: (lambda c, ctx: o.raiser())")
  do c over "USER", "NOTREADY"
    .CommandHandler~register("PYRAISER", .py~commandHandler(h~new(.Raiser~new(c))))
    self~assertSame("no condition", self~signalOnAnyAddress, c "from a method a Python handler calls")
    .CommandHandler~deregister("PYRAISER")
  end

::method signalOnAny private
  use arg pyCallable, o
  signal on user x; signal on notready; signal on error; signal on failure
  pyCallable~new(o)
  return "no condition"
x: notready: error: failure:
  return condition("C")

::method signalOnAnyAddress private
  signal on user x; signal on notready
  address pyraiser "x"
  return "no condition"
x: notready:
  return condition("C")

-- Rexx -> Python -> Rexx -> Python
::method test_nested
  self~assertSame("25", .py~eval("lambda f, x: f(x)")~new(self~routine("viaPython"), 5), "nested")

::routine byLength
  return length(arg(1))
::routine double
  return arg(1) * 2
::routine add
  return arg(1) + arg(2)
::routine makeDir
  return .directory~new
::routine fails
  return substr("x", 0)
::routine described
  raise syntax 40.1 array("BOOM") description "the description"
::routine halts
  raise halt description "h"
::routine haltsViaPython
  return .py~eval("lambda f: f()")~new(.context~package~findRoutine("halts"))
::routine viaPython
  return .py~pow(arg(1), 2)
::class Raiser
::method init
  expose c; use arg c
::method raiser
  expose c
  select
    when c == "USER" then raise user x
    when c == "NOTREADY" then raise notready
    when c == "ERROR" then raise error 1
    when c == "FAILURE" then raise failure 1
  end
