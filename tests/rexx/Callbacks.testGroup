#!/usr/bin/env rexx
/*----------------------------------------------------------------------------*/
/* Callbacks.testGroup: Rexx objects in Python (oorexx.RexxObject), called    */
/* back; identity on the way back; errors both ways; nesting.                 */
/*                                                                            */
/* Licensed under the Apache License, Version 2.0.                            */
/*----------------------------------------------------------------------------*/
  parse source . . fileSpec

  group = .TestGroup~new(fileSpec)
  group~add(.Callbacks.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires 'PyTestCase.cls'

::class "Callbacks.testGroup" subclass PyTestCase public

-- a routine of this file, as an object
::method routine private
  use strict arg name
  return .context~package~findRoutine(name)

::method test_routines_as_functions
  b = .py
  words = .array~of("pear", "fig", "banana", "kiwi")
  self~assertSame("['fig', 'pear', 'kiwi', 'banana']", -
                  b~sorted(words, b~kw("key", self~routine("byLength")))~string, "sorted key=routine")
  self~assertSame("[2, 4, 6]", -
                  b~eval("list")~new(b~map(self~routine("double"), .array~of(1, 2, 3)))~string, "list(map(...))")

::method test_rexx_object_in_python
  b = .py
  d = .directory~new
  d~color = "red"
  self~assertTrue(b~eval("lambda x: x")~new(d) == d, "round trip identity")
  self~assertSame("RexxObject", b~type(d)~__name__, "type")
  b~exec(self~py("def get(o, k): return o[k]",       -
                 "def put(o, k, v): o[k] = v",       -
                 "def send(o): return o.items()",    -
                 "def text(o): return str(o)",       -
                 "def each(o): return [x for x in o]"))
  m = b~main
  self~assertSame("red", m~get(d, "COLOR"), "Python o[k]")
  m~put(d, "SIZE", 3)
  self~assertSame("3", d~size, "Python o[k] = v")
  self~assertSame("2", m~send(d), "Python o.items()")
  self~assertSame("a Directory", m~text(d), "Python str(o)")
  self~assertSame("['a', 'b']", m~each(.array~of("a", "b"))~string, "Python iterates")
  self~assertSame("2", b~len(d), "len()")

::method test_arguments_and_results
  b = .py
  self~assertSame("42", b~eval("lambda f: f(20, 22)")~new(self~routine("add")), "callback args")
  self~assertSame("Directory", b~eval("lambda f: f()")~new(self~routine("makeDir"))~class~id, "callback returns obj")

-- errors in Rexx code reach Python as RexxError, and Rexx again as themselves
::method test_rexx_error_round_trip
  co = self~syntaxOf(.py~eval("lambda f: f()"), "new", self~routine("fails"))
  self~assertSame("93.924", co~code, "the Rexx error itself, not 98.900")
  self~assertTrue(pos("Invalid position", co~message) > 0, "its message")

-- a SYNTAX with a description comes back with it, through a Python function
-- and through an ADDRESS environment written in Python (raiseAgain raises
-- the kept condition object, RaiseConditionObject: RFE #883, r13329)
::method test_rexx_error_description
  co = self~syntaxOf(.py~eval("lambda f: f()"), "new", self~routine("described"))
  self~assertSame("40.1", co~code, "its code")
  self~assertSame("BOOM", co~additional[1], "its ADDITIONAL")
  self~assertSame("the description", co~description, "its description")
  h = .py~eval("lambda f: (lambda c, ctx: f())")~new(self~routine("described"))
  .CommandHandler~register("pydesc", .py~commandHandler(h))
  signal on syntax
  address pydesc "x"
  self~fail("SYNTAX 40.1 must come back through ADDRESS")
syntax:
  .CommandHandler~deregister("pydesc")
  co = condition("O")
  self~assertSame("40.1", co~code, "its code, through ADDRESS")
  self~assertSame("the description", co~description, "its description, through ADDRESS")

-- an ERROR or a FAILURE raised by Rexx code that Python calls comes back
-- with its RC, through a Python function, as in plain Rexx
::method test_error_failure_rc
  call = .py~eval("lambda f: f()")
  do r over "raisesError", "raisesFailure"
    plain = self~errorOf(.nil, self~routine(r))
    self~assertSame(plain, self~errorOf(call, self~routine(r)), r "through Python, as in plain Rexx")
  end
  self~assertSame("ERROR 127 127 e127", self~errorOf(call, self~routine("raisesError")), "ERROR's RC")
  self~assertSame("FAILURE -3 -3 f3", self~errorOf(call, self~routine("raisesFailure")), "FAILURE's RC")

::method errorOf private
  use arg pyCallable, f
  signal on error name trapped
  signal on failure name trapped
  if pyCallable == .nil then f~call
  else pyCallable~new(f)
  return "no condition"
trapped:
  return condition("C") rc condition("O")~rc condition("D")

::method test_python_catches_rexx_error
  b = .py
  b~exec(self~py("def catch(f):",                       -
                 "    import oorexx",                   -
                 "    try: f()",                        -
                 "    except Exception as e: return type(e).__name__"))
  self~assertSame("RexxError", b~main~catch(self~routine("fails")), "Python catches it")

-- a HALT in Rexx code called by Python is a HALT again back in Rexx (ooRexx
-- gives Python SYNTAX 4.1, with the description gone), as plain Rexx gives
-- it: CALL ON HALT runs the handler and the call then has no value (91.999);
-- untrapped, 4.1
::method test_halt_round_trip
  call = .py~eval("lambda f: f()")
  halts = self~routine("halts")
  self~assertSame("HALT", self~signalOnHalt(call, halts), "SIGNAL ON HALT")
  self~assertSame(self~callOnHalt(.nil, halts), self~callOnHalt(call, halts), "CALL ON HALT: as in plain Rexx")
  self~assertSame("HALT 91.999", self~callOnHalt(call, halts), "CALL ON HALT: the handler runs, then the call has no value")
  self~assertSame("4.1", self~syntaxOf(call, "new", halts)~code, "SYNTAX 4.1 when only SYNTAX is trapped")
  self~assertSame("HALT", self~signalOnHalt(call, self~routine("haltsViaPython")), -
                  "Rexx -> Python -> Rexx -> Python -> Rexx")

::method signalOnHalt private
  use arg pyCallable, f
  signal on halt
  pyCallable~new(f)
  return "no condition"
halt:
  return condition("C")

::method callOnHalt private
  use arg pyCallable, f
  call on halt name halted
  trapped = "no condition"
  signal on syntax name noValue
  if pyCallable == .nil then x = f~call
  else x = pyCallable~new(f)
  return trapped "value" x
halted:
  trapped = condition("C")
  return
noValue:
  return trapped condition("O")~code

::method test_signal_not_through_python
  send = .py~eval("lambda o: o.raiser()")
  do c over "USER", "NOTREADY", "ERROR", "FAILURE"
    self~assertSame(c, word(self~signalOnAny(send, .Raiser~new(c)), 1), c "from a method Python calls")
  end
  h = .py~eval("lambda o: (lambda c, ctx: o.raiser())")
  do c over "USER", "NOTREADY"
    .CommandHandler~register("PYRAISER", .py~commandHandler(h~new(.Raiser~new(c))))
    self~assertSame(c, word(self~signalOnAnyAddress, 1), c "from a method a Python handler calls")
    .CommandHandler~deregister("PYRAISER")
  end

-- rule 1 for a condition other than SYNTAX: back in Rexx with its
-- description and ADDITIONAL, through a function and through ADDRESS; Python
-- sees it as a RexxError it can catch
::method test_other_conditions_round_trip
  call = .py~eval("lambda f: f()")
  d = self~conditionOf(call, self~routine("userDescribed"))
  self~assertSame("USER X", d~condition, "USER X through a function")
  self~assertSame("the description", d~description, "its description")
  self~assertSame("A", d~additional[1], "its ADDITIONAL")
  .CommandHandler~register("PYUSER", .py~commandHandler(.py~eval("lambda f: (lambda c, ctx: f())")~new(self~routine("userDescribed"))))
  signal on user x name viaAddress
  address pyuser "x"
  self~fail("USER X must come back through ADDRESS")
viaAddress:
  .CommandHandler~deregister("PYUSER")
  self~assertSame("the description", condition("D"), "its description, through ADDRESS")
  self~assertSame("A", condition("O")~additional[1], "its ADDITIONAL, through ADDRESS")
  .py~exec(self~py("def caught(f):",                        -
                   "    try: f()",                          -
                   "    except Exception as e: return type(e).__name__ + ': ' + str(e)"))
  self~assertSame("RexxError: Rexx condition USER X", .py~main~caught(self~routine("userDescribed")), "Python catches it")

-- RAISE ... RETURN v in Rexx code called through Python: the Rexx caller
-- gets v, untrapped and under CALL ON, as in plain Rexx (not Error 91 or
-- 44.1); SIGNAL ON traps it.  A workaround: condition("O")~result is v too,
-- where plain Rexx has none
::method test_raise_return_value
  call = .py~eval("lambda f: f()")
  r = self~routine("userDescribed")
  signal on syntax name noValue
  x = call~new(r)
  signal off syntax
  self~assertSame(7, x, "untrapped: the value")
  ran = 0; res = "none"
  call on user x name handler
  x = call~new(r)
  call off user x
  self~assertSame(7, x, "CALL ON: the value")
  self~assertSame(1, ran, "CALL ON: the handler ran")
  self~assertSame(7, res, "CALL ON: the workaround's RESULT")
  self~assertSame("USER X", self~conditionOf(call, r)~condition, "SIGNAL ON traps it")
  -- an object comes back as itself, by reference
  o = .directory~new
  x = .py~eval("lambda f, x: f(x)")~new(self~routine("raisesWith"), o)
  self~assertSame(o, x, "an object: itself")
  .CommandHandler~register("PYRET", .py~commandHandler(.py~eval("lambda f: (lambda c, ctx: f())")~new(r)))
  address pyret "x"
  .CommandHandler~deregister("PYRET")
  self~assertSame(7, rc, "through ADDRESS: the value as RC")
  return
handler:
  ran = ran + 1
  if condition("O")~hasIndex("RESULT") then res = condition("O")~result
  return
noValue:
  self~fail("Error" condition("O")~code "instead of the value")

-- user code the bridge runs while converting a value (a .String subclass's
-- MAKESTRING): a SYNTAX it raises is the call's own, never a crash.  In a
-- reply of Rexx code that Python calls it reaches Python as a RexxError and
-- the Rexx caller as itself; in an argument for Python, the Rexx caller gets
-- it and Python is not called
::method test_reply_conversion_raises
  call = .py~eval("lambda f: f()")
  signal on syntax name viaReply
  call~new(self~routine("badReply"))
  self~fail("SYNTAX 93.900 must come back from the reply")
viaReply:
  self~assertSame("93.900", condition("O")~code, "the reply's SYNTAX")
  self~assertSame("boom in MAKESTRING", condition("O")~additional[1], "its ADDITIONAL")
  .py~exec(self~py("def caught(f):",                        -
                   "    try: f()",                          -
                   "    except Exception as e: return type(e).__name__ + ' ' + e.code"))
  self~assertSame("RexxError 93.900", .py~main~caught(self~routine("badReply")), "Python catches it")
  .py~exec(self~py("called = []",                           -
                   "def note(x): called.append(x)"))
  signal on syntax name viaArgument
  .py~main~note(.BadString~new("abc"))
  self~fail("SYNTAX 93.900 must come from the argument")
viaArgument:
  self~assertSame("93.900", condition("O")~code, "the argument's SYNTAX")
  self~assertSame(0, .py~eval("len(called)"), "Python was not called")
  -- a USER raised in MAKESTRING itself reaches the caller, as in plain Rexx
  signal on user x name userReply
  call~new(self~routine("userReply"))
  self~fail("USER X must come back from the reply")
userReply:
  self~assertSame("in MAKESTRING", condition("D"), "the reply's USER")

-- a native routine that uses its caller's variables (rexxutil's SysFileTree
-- with a stem name) called from Python: there is no Rexx caller, so it is
-- SYNTAX 40.925, not a crash (#2129, r13326); with a stem object it works
::method test_native_routine_from_python
  sft = .context~package~findRoutine("SFT")
  f = .py~eval("lambda f, *a: f(*a)")
  pattern = filespec("location", .context~package~name) || "*.testGroup"
  call SysFileTree pattern, "direct.", "FO"
  s = .stem~new
  self~assertSame(0, f~new(sft, pattern, s, "FO"), "SysFileTree with a stem object")
  self~assertSame(direct.0, s[0], "the stem object filled")
  signal on syntax name noCaller
  f~new(sft, pattern, "T.", "FO")
  self~fail("SYNTAX 40.925 must come back")
noCaller:
  self~assertSame("40.925", condition("O")~code, "a stem name: no Rexx caller")

-- a conversion stops at the first condition user code raises (as Rexx
-- stops at the first error): an Array or arguments whose second item would
-- fail too give the first item's SYNTAX, with only one MAKESTRING run; a
-- STRING method answering such a string is SYNTAX, not a crash; keyword
-- arguments whose NAMES is no Array are an error
::method test_conversion_stops_at_first_condition
  .local~orxpy.calls = 0
  self~assertSame("93.900 boom 1", self~syntaxText(.py~eval("lambda x: len(x)"), .array~of(.CountingBad~new("a"), .CountingBad~new("b"))), "an Array")
  self~assertSame(1, .local~orxpy.calls, "an Array: one MAKESTRING")
  .local~orxpy.calls = 0
  self~assertSame("93.900 boom 1", self~syntaxText(.py~eval("lambda x, y: 0"), .CountingBad~new("a"), .CountingBad~new("b")), "arguments")
  self~assertSame(1, .local~orxpy.calls, "arguments: one MAKESTRING")
  .local~orxpy.calls = 0
  signal on syntax name boxed
  .py~box("str", .AnswersBad~new)
  self~fail("SYNTAX 93.900 must come from box")
boxed:
  self~assertSame("93.900", condition("O")~code, "box: STRING answering a failing string")
  signal on syntax name keywords
  .py~eval("lambda **k: len(k)")~new(.OddKw~new(.array~of("a", 1)))
  self~fail("an error must come from the keyword arguments")
keywords:
  self~assertSame("98.900", condition("O")~code, "keyword arguments: NAMES no Array")

::method syntaxText private
  use arg pyCallable, a1, a2
  signal on syntax
  if arg() = 2 then pyCallable~new(a1)
  else pyCallable~new(a1, a2)
  return "no condition"
syntax:
  return condition("O")~code condition("O")~additional[1]

::method conditionOf private
  use arg pyCallable, f
  signal on user x
  pyCallable~new(f)
  self~fail("USER X must come back")
x:
  return condition("O")

::method signalOnAny private
  use arg pyCallable, o
  signal on user x; signal on notready; signal on error; signal on failure
  pyCallable~new(o)
  return "no condition"
x: notready: error: failure:
  return condition("C")

::method signalOnAnyAddress private
  signal on user x; signal on notready
  address pyraiser "x"
  return "no condition"
x: notready:
  return condition("C")

-- Rexx -> Python -> Rexx -> Python
::method test_nested
  self~assertSame("25", .py~eval("lambda f, x: f(x)")~new(self~routine("viaPython"), 5), "nested")

::routine byLength
  return length(arg(1))
::routine double
  return arg(1) * 2
::routine add
  return arg(1) + arg(2)
::routine makeDir
  return .directory~new
::routine fails
  return substr("x", 0)
::routine described
  raise syntax 40.1 array("BOOM") description "the description"
::routine userDescribed
  raise user x description "the description" array("A") return 7
::routine raisesWith
  use arg o
  raise user x return (o)
::routine badReply
  return .BadString~new("abc")
::routine userReply
  return .UserString~new("abc")
::routine SFT external "LIBRARY rexxutil SysFileTree"
::routine raisesError
  raise error 127 description "e127"
::routine raisesFailure
  raise failure (-3) description "f3"
::routine halts
  raise halt description "h"
::routine haltsViaPython
  return .py~eval("lambda f: f()")~new(.context~package~findRoutine("halts"))
::routine viaPython
  return .py~pow(arg(1), 2)
::class Raiser
::method init
  expose c; use arg c
::method raiser
  expose c
  select
    when c == "USER" then raise user x
    when c == "NOTREADY" then raise notready
    when c == "ERROR" then raise error 1
    when c == "FAILURE" then raise failure 1
  end

-- a string whose MAKESTRING raises a SYNTAX (test_reply_conversion_raises)
::class BadString subclass String
::method makestring
  raise syntax 93.900 array("boom in MAKESTRING")
::class UserString subclass String
::method makestring
  raise user x description "in MAKESTRING"
  return "bad"

-- test_conversion_stops_at_first_condition
::class CountingBad subclass String
::method makestring
  .local~orxpy.calls = .local~orxpy.calls + 1
  raise syntax 93.900 array("boom" .local~orxpy.calls)
::class AnswersBad
::method string
  return .CountingBad~new("x")
::class OddKw subclass PyKwArgs
::method names
  return "not an array"
