#!/usr/bin/env rexx
/*----------------------------------------------------------------------------*/
/* Samples.testGroup: every nutshell sample (samples, .rex and .py) runs,     */
/* in its own process, with the Python of ORX_PYTHON, and prints exactly what */
/* its Output block says.  So the samples cannot rot.                         */
/*                                                                            */
/* Environment: ORX_PYTHON (the Python, as for any Rexx program using the     */
/* bridge), ORXPY_BUILD (the build directory, default $ORXPY_WORK/build,      */
/* where ORXPY_WORK defaults to the directory that contains the clone).       */
/*                                                                            */
/* Licensed under the Apache License, Version 2.0.                            */
/*----------------------------------------------------------------------------*/
  parse source . . fileSpec

  group = .TestGroup~new(fileSpec)
  group~add(.Samples.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

::requires 'PyTestCase.cls'

::class "Samples.testGroup" subclass PyTestCase public

::method test_all_samples
  parse source . . me
  sl = .File~separator
  dir = .File~new(me)~parentFile~parentFile~parentFile~absolutePath || sl || "samples"
  build = value("ORXPY_BUILD", , "ENVIRONMENT")
  if build == "" then do
    work = value("ORXPY_WORK", , "ENVIRONMENT")
    if work == "" then work = .File~new(dir)~parentFile~parentFile~absolutePath
    build = work || sl || "build"
  end
  python = value("ORX_PYTHON", , "ENVIRONMENT")
  if python == "" then python = "python3"
  -- librexxpython is found by name through the library path; macOS drops
  -- DYLD_* variables when it starts /bin/sh (ADDRESS SYSTEM), so the command
  -- sets it itself
  parse upper source platform .
  windows = platform~abbrev("WIN")
  libvar = ""
  if platform~pos("DARWIN") > 0 | platform~pos("MAC") > 0 then
    libvar = "DYLD_LIBRARY_PATH='"build"' "
  tmp = value("TMPDIR", , "ENVIRONMENT")
  if tmp == "" then tmp = value("TEMP", , "ENVIRONMENT")
  if tmp == "" then tmp = "/tmp"
  work = .File~new(tmp)~absolutePath || sl || "orxpy-samples"
  call SysMkDir work

  files = .File~new(dir)~listFiles
  names = .array~new
  do f over files
    if f~name~endsWith(".rex") | f~name~endsWith(".py") then names~append(f~absolutePath)
  end
  names = names~sort
  self~assertTrue(names~items >= 20, "samples found in" dir)

  -- before 5.3.0, using one interpreter from several threads at once crashes
  -- inside ooRexx (docs/design.md, *ooRexx versions*): skip the samples that
  -- do it there
  concurrent = .set~of("09-threads.rex")
  parse version "REXX-ooRexx_" major "." minor "."
  oldOoRexx = major < 5 | (major = 5 & minor < 3)

  failures = .array~new
  do path over names
    if oldOoRexx, concurrent~hasIndex(.File~new(path)~name) then iterate
    expected = self~expectedOutput(path)
    if expected == .nil then do
      failures~append(path": no Output block")
      iterate
    end
    if windows then do                 -- cmd.exe
      if path~endsWith(".py") then
        cmd = 'cd /d "'work'" && set "PYTHONPATH='build'" && "'python'" "'path'" 2>&1'
      else
        cmd = 'cd /d "'work'" && rexx "'path'" 2>&1'
    end
    else if path~endsWith(".py") then
      cmd = 'cd "'work'" && PYTHONPATH="'build'" "'python'" "'path'" 2>&1'
    else
      cmd = 'cd "'work'" && 'libvar'rexx "'path'" 2>&1'
    out = .array~new
    address system cmd with output using (out)
    do i = 1 to out~items              -- Windows: lines may end in CR
      if out[i]~right(1) == "0d"x then out[i] = out[i]~left(out[i]~length - 1)
    end
    got = out~makeString("L", "0a"x)
    if got == expected then self~assertTrue(.true)
    else failures~append(.File~new(path)~name || "0a"x ||,
                         "  expected: [" || expected~changeStr("0a"x, "|") || "]" || "0a"x ||,
                         "  got:      [" || got~changeStr("0a"x, "|") || "]")
  end
  if failures~items > 0 then
    self~fail(failures~items "sample(s) differ:" || "0a"x || failures~makeString("L", "0a"x))

/** expectedOutput(path)
 * The lines of the sample's Output block: in a Rexx file, the lines between
 * the comment line that opens with "Output:" and the line that closes it; in
 * a Python file, the "# " comment lines after a line "# Output:".  .nil if
 * there is none.
 */
::method expectedOutput private
  use strict arg path
  s = .stream~new(path)
  lines = s~arrayIn
  s~close                              -- Windows: an open file cannot be run
  python = path~endsWith(".py")
  marker = (python)~?("# Output:", "/" || "* Output:")
  start = 0
  do i = 1 to lines~items
    if lines[i]~strip == marker then do; start = i; leave; end
  end
  if start == 0 then return .nil
  out = .array~new
  do i = start + 1 to lines~items
    line = lines[i]
    if python then do
      if \line~startsWith("#") then leave
      out~append(line~substr(3))       -- "# text" -> "text"; "#" -> ""
    end
    else do
      if line~strip == "*" || "/" then leave
      out~append(line)
    end
  end
  return out~makeString("L", "0a"x)
