#!/usr/bin/env rexx
/*----------------------------------------------------------------------------*/
/* examples-deck.rex [OUT]: the nutshell examples as one md2slides deck.      */
/*                                                                            */
/* md2slides is the Rexx Parser's slide tool                                  */
/* (https://rexx.epbcn.com/rexx-parser/doc/utilities/md2slides/).  The deck   */
/* is made from the examples themselves, so it says what they say: one slide  */
/* per example (two for the longest), with its code, the Python it replaces   */
/* and its output (the output Examples.testGroup checks).  Titles and         */
/* sections come from examples/README.md; its "Things worth knowing" closes   */
/* the deck.  Run it again after changing an example or the README (CI checks */
/* that the deck is up to date).                                              */
/*                                                                            */
/* OUT defaults to examples/slides/examples.md.  Build the slides with        */
/*   md2slides [-s skin.css] [-mp master.css] examples.md                     */
/*                                                                            */
/* Licensed under the Apache License, Version 2.0.                            */
/*----------------------------------------------------------------------------*/
  parse source . . me
  sep = .file~separator
  root = .file~new(me)~parentFile~parentFile~absolutePath
  dir = root || sep || "examples"
  parse arg out
  out = out~strip
  if out == "" then out = dir || sep || "slides" || sep || "examples.md"

  readme = readLines(dir || sep || "README.md")
  deck = .array~new

  -- the cover
  deck~append("---")
  deck~append("rexxpub:")
  deck~append("  title: ooRexx/Python in a nutshell")
  deck~append("  logo: oorexx")
  deck~append("---")
  deck~append("")
  deck~append("<!-- Generated by scripts/examples-deck.rex from the examples: do not edit. -->")
  deck~append("")
  deck~append("# ooRexx/Python in a nutshell {.title-slide}")
  deck~append("")
  deck~append("::: subtitle")
  deck~append("Short programs, each showing one thing")
  deck~append(":::")
  deck~append("")
  deck~append("--- {.slide #how-to-read}")
  deck~append("")
  deck~append("# How to read the examples")
  deck~append("")
  deck~append("- Each example is a short program, ooRexx using Python (`.rex`) or")
  deck~append("  Python using ooRexx (`.py`).")
  deck~append("- Next to it: the Python it replaces, and its output, exactly.")
  deck~append("- Every example is run with every Python from 3.9 to 3.13, on Linux,")
  deck~append("  macOS and Windows, and its output checked.")
  deck~append("- A Rexx program needs `::requires ""python.cls""`; a Python program,")
  deck~append("  `import oorexx`.")

  -- one section per table of the README, one slide per row
  section = ""
  do i = 1 to readme~items
    line = readme[i]
    if line~startsWith("## Things worth knowing") then leave
    if line~startsWith("## ") then do
      section = line~substr(4)
      iterate
    end
    if \line~startsWith("| `") then iterate
    parse var line "| `" file "` | " shows " |"
    if file~right(4) \== ".rex" & file~right(3) \== ".py" then iterate
    if section \== "" then do
      deck~append("")
      deck~append("#" section "{.section}")
      section = ""
    end
    deck~appendAll(slide(dir || sep || file, file, shows))
  end

  -- "Things worth knowing", as it is in the README
  deck~append("")
  deck~append("# Things worth knowing")
  deck~append("")
  deck~append("::: {.contents scale=0.8}")
  do i = i + 1 to readme~items
    deck~append(readme[i])
  end
  do while deck~lastItem == ""; deck~delete(deck~last); end
  deck~append(":::")

  call writeLines out, deck
  say out
  exit 0

/* One example's slide (or two): the prose of its header, its program, the  */
/* Python it replaces and its output.                                        */
::routine slide
  use arg path, file, shows
  src = readLines(path)
  prose = .array~new; python = .array~new; code = .array~new; output = .array~new
  if file~right(4) == ".rex" then do
    lang = "rexx"
    -- header: /* NN-name.rex: summary ... * Python: ... */
    i = 1
    first = src[1]~substr(3)~strip
    parse var first (file) ":" first
    prose~append(first~strip)
    inPython = .false
    do i = 2 while \src[i]~strip~startsWith("*/")
      l = src[i]
      parse var l " *" rest
      if rest~strip == "Python:" then do; inPython = .true; iterate; end
      if inPython then python~append(rest~substr(4))
      else prose~append(rest~strip)
    end
    do i = i + 1 while \src[i]~startsWith("/* Output:")
      code~append(src[i])
    end
    do i = i + 1 while src[i] \== "*/"
      output~append(src[i])
    end
  end
  else do
    lang = "python"
    -- """NN-name.py: summary ... """ then code, then # Output: lines
    first = src[1]~substr(4)
    parse var first (file) ":" first
    prose~append(first~strip)
    do i = 2 while src[i]~strip \== '"""'
      prose~append(src[i]~strip)
    end
    do i = i + 1 while src[i] \== "# Output:"
      code~append(src[i])
    end
    do i = i + 1 to src~items
      output~append(src[i]~substr(3))
    end
  end
  call trim code

  s = .array~new
  id = "ex" || file~left(file~lastPos(".") - 1)    -- 01-hello.rex: #ex01-hello
  heading = "#" capital(shows)
  kicker = "kicker=""" || file || """"
  text = prose~makeString("L", " ")~space
  if text \== "" then text = capital(text)
  call trim python

  -- The layout.  A slide that does not fit is made smaller when it is shown
  -- (to 45% at most), so take the layout that needs the least of that:
  --   side:    the program beside the Python and the output;
  --   stacked: the program on top, the Python and the output under it;
  --   split:   the program alone, then a second slide with the prose, the
  --            Python and the output (when neither fits at 75%).
  -- The sizes, measured on md2slides' slides: a slide holds 92 characters of
  -- code across (a block's padding takes 3) and 18 lines down; a block takes
  -- a line more than its own, a labelled one three; a line of prose holds 80
  -- characters and takes two lines of code.
  hx = 0; if text \== "" then hx = (length(text) + 79) % 80 * 2
  wc = width(code); hc = code~items + 1
  wr = width(output); hr = output~items + 3
  if python~items > 0 then do
    wr = max(wr, width(python)); hr = hr + python~items + 3
  end
  side = 0; cols = 6                   -- the best share of twelve columns
  do n = 3 to 9
    f = min(1, 92 * n / 12 / (wc + 3), 92 * (12 - n) / 12 / (wr + 3), 18 / (hx + max(hc, hr)))
    if f > side then do; side = f; cols = n; end
  end
  stacked = min(1, 92 / (wc + 3), pair(python, output, hx + hc)[1])
  split = min(1, 92 / (wc + 3), 18 / hc, pair(python, output, hx)[1])

  s~append("")
  s~append(heading "{#" || id kicker || "}")
  s~append("")
  select
    when max(side, stacked) < 0.75 & split > max(side, stacked) then do
      s~appendAll(block(lang, code))
      s~append("")
      s~append(heading "{#" || id || "-2" kicker || "}")
      s~append("")
      if text \== "" then s~appendAll(.array~of(text, ""))
      s~appendAll(pair(python, output, hx)[2])
    end
    when side > stacked then do
      if text \== "" then s~appendAll(.array~of(text, ""))
      s~append("::: row")
      s~append("::: col-" || cols)
      s~appendAll(block(lang, code))
      s~append(":::")
      s~append("::: col-" || 12 - cols)
      if python~items > 0 then s~appendAll(labelled("Python", "python", python))
      s~appendAll(labelled("Output", "output", output))
      s~append(":::")
      s~append(":::")
    end
    otherwise
      if text \== "" then s~appendAll(.array~of(text, ""))
      s~appendAll(block(lang, code))
      s~append("")
      s~appendAll(pair(python, output, hx + hc)[2])
  end
  return s

/* The Python and the output, under HEIGHT lines of something else: side by */
/* side or one under the other, whichever is bigger.  Returns the scale and  */
/* the lines.                                                                */
::routine pair
  use arg python, output, height
  wo = width(output); ho = output~items + 3
  if python~items = 0 then
    return .array~of(min(1, 92 / (wo + 3), 18 / (height + ho)), labelled("Output", "output", output))
  wp = width(python); hp = python~items + 3
  best = min(1, 92 / (max(wp, wo) + 3), 18 / (height + hp + ho))       -- one under the other
  cols = 0
  do n = 3 to 9
    f = min(1, 92 * n / 12 / (wp + 3), 92 * (12 - n) / 12 / (wo + 3), 18 / (height + max(hp, ho)))
    if f > best then do; best = f; cols = n; end
  end
  if cols = 0 then do
    b = labelled("Python", "python", python)
    b~appendAll(labelled("Output", "output", output))
    return .array~of(best, b)
  end
  b = .array~of("::: row", "::: col-" || cols)
  b~appendAll(labelled("Python", "python", python))
  b~append(":::")
  b~append("::: col-" || 12 - cols)
  b~appendAll(labelled("Output", "output", output))
  b~append(":::")
  b~append(":::")
  return .array~of(best, b)

::routine block                         -- a fenced code block
  use arg lang, lines
  b = .array~of("```" || lang)
  b~appendAll(lines)
  b~append("```")
  return b

::routine labelled                      -- a caption, then its block
  use arg label, lang, lines
  b = .array~of("[" || label || "]{.label}", "")
  b~appendAll(block(lang, lines))
  b~append("")
  return b

::routine width                         -- the longest line
  use arg lines
  w = 0
  do l over lines; w = max(w, length(l)); end
  return w

::routine capital                       -- the first letter in upper case
  use arg text
  return text~left(1)~upper || text~substr(2)

::routine trim                          -- drop leading and trailing empty lines
  use arg a
  do while a~items > 0, a[1]~strip == ""; a~delete(1); end
  do while a~items > 0, a~lastItem~strip == ""; a~delete(a~last); end

::routine readLines                         -- a file's lines, as an Array
  use arg name
  s = .stream~new(name)
  if s~open("read") \== "READY:" then do
    say "examples-deck.rex: cannot read" name
    exit 1
  end
  a = s~arrayIn
  s~close
  return a

::routine writeLines                    -- LF line ends on every platform
  use arg name, a
  s = .stream~new(name)
  call SysFileDelete name
  if s~open("write replace") \== "READY:" then do
    say "examples-deck.rex: cannot write" name
    exit 1
  end
  s~charOut(a~makeString("L", "0a"x) || "0a"x)
  s~close
